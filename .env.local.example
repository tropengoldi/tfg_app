# Vorlage fuer .env.local — nur Dummy-Werte, niemals echte Secrets hier eintragen.
# Kopieren mit:  cp .env.local.example .env.local
# .env.local ist gitignored, diese Vorlage wird eingecheckt.

# ---------------------------------------------------------------------------
# Supabase
# Werte findest du unter: Supabase Dashboard -> Project Settings -> API
# Projekt: tfg_app (ogwuwisutgaxxpknkgpg), Region eu-central-1
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Service Role Key — NUR serverseitig. NIEMALS mit NEXT_PUBLIC_ praefixen,
# sonst landet er im Browser-Bundle und jeder Teilnehmer kann alle Daten lesen.
# Wird ausschliesslich in src/app/api/admin/teilnehmer/route.ts verwendet
# (Teilnehmer einladen und deaktivieren).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Basis-URL der App. Lokal http://localhost:3000, live die Vercel-Domain.
# Muss zusaetzlich in Supabase unter Auth -> URL Configuration -> Redirect URLs
# eingetragen werden, sonst laufen die Einladungslinks ins Leere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# E-Mail-Versand fuer PROJ-16 (Nachrichten an Teilnehmer)
# Eigenes App-Passwort fuer dieselbe Gmail-Adresse, die schon fuer das
# Supabase-Custom-SMTP eingerichtet ist (Google-Kontoeinstellungen -> Sicherheit
# -> App-Passwoerter). Separates Geheimnis, getrennt von Supabases eigener
# SMTP-Konfiguration und vom Service-Role-Key. Ohne diese Variablen wirft der
# Mailversand beim Senden einer Nachricht einen Fehler.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your_app_password_here
# Optional; faellt sonst auf SMTP_USER zurueck.
SMTP_FROM=your-gmail-address@gmail.com

# ---------------------------------------------------------------------------
# Optional: nur fuer den VPS-Self-Hosting-Pfad (docker-compose.app.yml +
# Caddyfile), siehe docs/production/vps-self-hosted.md. Fuer Vercel/lokale
# Entwicklung irrelevant, hier nur der Vollstaendigkeit halber dokumentiert.
# ---------------------------------------------------------------------------

DOMAIN_APP=app.your-domain.tld
DOMAIN_API=api.your-domain.tld
DOMAIN_STUDIO=studio.your-domain.tld
STUDIO_BASIC_AUTH_USER=admin
STUDIO_BASIC_AUTH_HASH=generated_via_caddy_hash-password
