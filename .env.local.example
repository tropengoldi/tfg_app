# Vorlage fuer .env.local — nur Dummy-Werte, niemals echte Secrets hier eintragen.
# Kopieren mit:  cp .env.local.example .env.local
# .env.local ist gitignored, diese Vorlage wird eingecheckt.

# ---------------------------------------------------------------------------
# Supabase
# Werte findest du unter: Supabase Dashboard -> Project Settings -> API
# Projekt: tfg_app (ogwuwisutgaxxpknkgpg), Region eu-central-1
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Service Role Key — NUR serverseitig. NIEMALS mit NEXT_PUBLIC_ praefixen,
# sonst landet er im Browser-Bundle und jeder Teilnehmer kann alle Daten lesen.
# Wird ausschliesslich in src/app/api/admin/teilnehmer/route.ts verwendet
# (Teilnehmer einladen und deaktivieren).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Basis-URL der App. Lokal http://localhost:3000, live die Vercel-Domain.
# Muss zusaetzlich in Supabase unter Auth -> URL Configuration -> Redirect URLs
# eingetragen werden, sonst laufen die Einladungslinks ins Leere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
